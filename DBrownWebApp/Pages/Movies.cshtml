@page
@using DBrownWebApp.Data.Models
@using DBrownWebApp.Pages
@model MoviesModel
@{
    ViewData["Title"] = "Movies";
}
<h1>Movies</h1>

<h3>Add a New Movie!</h3>
<form method="post">
    <input name="id" type="hidden" value="@Model.NewMovie.Id"/>
    <div>
        <label asp-for="@Model.NewMovie.Title"></label>
        <input asp-for="@Model.NewMovie.Title"/>
        <span asp-validation-for="@Model.NewMovie.Title" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="@Model.NewMovie.Year"></label>
        <input asp-for="@Model.NewMovie.Year"/>
        <span asp-validation-for="@Model.NewMovie.Year" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="@Model.NewMovie.Score"></label>
        <input asp-for="@Model.NewMovie.Score"/>
        <span asp-validation-for="@Model.NewMovie.Score" class="text-danger"></span>
    </div>
    <div>
        <input type="submit" value="Add Movie"/>
    </div>
</form>

<form method="get">
    <label for="sort">Sort movies by:</label>

    <select id="sort" name="sort" onchange="this.form.submit()">
        <option value="title" selected="@(Model.Sort == "title")">
            Title
        </option>
        <option value="year" selected="@(Model.Sort == "year")">
            Year
        </option>
        <option value="score" selected="@(Model.Sort == "score")">
            Score
        </option>
    </select>
</form>

<table class="movie-table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Year</th>
            <th>Score</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Movie movie in Model.Movies)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Year</td>
                <td>@movie.Score</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}